# ------------------------------------------------------------
# Root .gitignore for Vite + React + Electron Forge + FastAPI/Python
# Commit lockfiles (package-lock.json/yarn.lock/pnpm-lock.yaml/poetry.lock) on purpose.
# ------------------------------------------------------------

# OS junk
.DS_Store
Thumbs.db
Icon?
.Spotlight-V100
.Trashes

# Editor/IDE
.vscode/
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node / JS tool caches
node_modules/
.pnpm-store/
.eslintcache
.stylelintcache
.cache/
.parcel-cache/

# Vite / Frontend build output
# Ignore general dist for frontend; we'll re-include backend/dist below
dist/
out/
.vite/

# Electron Forge / packaging output
make/
release/

# Test coverage
coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo

# Env files (keep example files)
.env
.env.*
!.env.example

# Python caches
__pycache__/
*.py[cod]
*$py.class

# Python venvs
.venv/
venv/
ENV/
env/
.conda/

# Python tooling caches
.mypy_cache/
.pytest_cache/
.pytype/
.ruff_cache/
.pyre/

# Python packaging & build artifacts
build/
# If you publish Python wheels/sdists locally
.eggs/
*.egg-info/
pip-wheel-metadata/

# NOTE: dist/ is used by both JS bundlers and PyInstaller
# We ignore dist/ globally above but explicitly re-include backend dist below.

# PyInstaller artifacts
# PyInstaller uses build/ and dist/. We IGNORE build/, but we WANT backend/dist tracked.
# Do NOT ignore *.spec because this project tracks file-filter-backend.spec
# *.spec  <-- intentionally NOT ignored

# ------------------------------
# Backend-specific overrides
# ------------------------------

/File-Filter-Copier/backend/build/
# Fully ignore backend/dist (no re-includes)
 /File-Filter-Copier/backend/dist/

# Keep backend __pycache__ tracked (optional)
!/File-Filter-Copier/backend/__pycache__/
!/File-Filter-Copier/backend/__pycache__/**
!/File-Filter-Copier/backend/**/__pycache__/
!/File-Filter-Copier/backend/**/__pycache__/**

# ------------------------------
# Backend generated folders (clarity)
# ------------------------------
# Keep ignoring any JS/Python build outputs elsewhere by default,
# while allowing backend/dist and backend/__pycache__ to be committed.

# Temporary files
.tmp/
*.tmp
~*

# ------------------------------------------------------------
# Root .gitignore for Vite + React + Electron Forge + FastAPI/Python
# Commit lockfiles (package-lock.json/yarn.lock/pnpm-lock.yaml/poetry.lock) on purpose.
# ------------------------------------------------------------

# OS junk
.DS_Store
Thumbs.db
.Spotlight-V100
.Trashes
generate_icns.py
macos_icon_padding.py

# Editor/IDE
.vscode/
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node / JS tool caches
node_modules/
.pnpm-store/
.eslintcache
.stylelintcache
.cache/
.parcel-cache/

# Vite / Frontend build output
dist/
out/
.vite/

# Electron Forge / packaging output
make/
release/
Installers/

# Test coverage
coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo

# Env files (keep example files)
.env
.env.*
!.env.example

# Python caches
__pycache__/
*.py[cod]
*$py.class

# Python venvs
.venv/
venv/
ENV/
env/
.conda/

# Python tooling caches
.mypy_cache/
.pytest_cache/
.pytype/
.ruff_cache/
.pyre/

# Python packaging & build artifacts
build/
.eggs/
*.egg-info/
pip-wheel-metadata/

# ------------------------------
# Backend-specific overrides
# ------------------------------

# Ignore backend build artifacts
backend/build/
backend/dist/

# Temporary files
.tmp/
*.tmp
~*